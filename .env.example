# =============================================================================
# Smart City Booking Store Front – Umgebungsvariablen
# Kopiere diese Datei nach `.env` und passe die Werte an.
# =============================================================================

# --- Backend (Pflicht) -------------------------------------------------------
# Basis-URL des smart-city-booking-backend (ohne trailing slash)
NUXT_API_BASE_URL=http://localhost:8080

# Öffentliche Backend-URL (optional, falls vom Client aus benötigt)
# NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Store-Front URLs (Pflicht für Auth-E-Mails & Redirects) -----------------
# Öffentliche URL dieser Anwendung (z. B. https://booking.example.com)
NUXT_USER_BASE_URL=http://localhost:3000
NUXT_PUBLIC_USER_BASE_URL=http://localhost:3000

# --- Admin-Portal (optional) -------------------------------------------------
# Link zum Admin-Interface für Nutzer mit Mitgliedschaften
NUXT_ADMIN_BASE_URL=
NUXT_PUBLIC_ADMIN_BASE_URL=

# --- Feature-Flags -----------------------------------------------------------
# Stilles SSO beim Seitenaufruf (Keycloak)
NUXT_PUBLIC_SILENT_SSO_ENABLED=false

# Server-seitiger SWR-Cache für Katalog- und Theme-Proxies (Standard: aktiv)
# Setze auf "false", um den Cache zu deaktivieren (empfohlen für lokale Entwicklung)
NUXT_CACHE_ENABLED=false

# --- Logging -----------------------------------------------------------------
# Pino Log-Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Runtime (Docker / Produktion) -------------------------------------------
# PORT=3000
# NODE_ENV=production
