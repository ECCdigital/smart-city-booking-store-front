# =============================================================================
# Smart City Booking Store Front – Environment Variables
# Copy this file to `.env` and adjust the values.
# =============================================================================

# --- Backend (required) --------------------------------------------------------
# Base URL of smart-city-booking-backend (no trailing slash)
NUXT_API_BASE_URL=http://localhost:8080

# Public backend URL (optional, if needed by the client)
# NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Store front URLs (required for auth emails & redirects) -------------------
# Public URL of this application (e.g. https://booking.example.com)
NUXT_USER_BASE_URL=http://localhost:3000
NUXT_PUBLIC_USER_BASE_URL=http://localhost:3000

# --- Admin portal (optional) ---------------------------------------------------
# Link to the admin interface for users with memberships
NUXT_ADMIN_BASE_URL=
NUXT_PUBLIC_ADMIN_BASE_URL=

# --- Feature flags -------------------------------------------------------------
# Silent SSO on page load (Keycloak)
NUXT_PUBLIC_SILENT_SSO_ENABLED=false

# Server-side SWR cache for catalog and theme proxies (enabled by default)
# Set to "false" to disable the cache (recommended for local development)
NUXT_CACHE_ENABLED=false

# --- Logging -------------------------------------------------------------------
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Runtime (Docker / production) ---------------------------------------------
# PORT=3000
# NODE_ENV=production
