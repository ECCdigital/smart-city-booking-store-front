# =============================================================================
# Smart City Booking Store Front – Environment Variables
# Copy this file to `.env` and adjust the values.
# =============================================================================

# --- Backend (required) --------------------------------------------------------
# Base URL of smart-city-booking-backend (no trailing slash)
NUXT_API_BASE_URL=http://localhost:8081

# Public backend URL (optional, if needed by the client)
# NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Store front URLs (required for auth emails & redirects) -------------------
# Public URL of this application (e.g. https://booking.example.com)
NUXT_USER_BASE_URL=http://localhost:3000
NUXT_PUBLIC_USER_BASE_URL=http://localhost:3000

# --- Admin portal (optional) ---------------------------------------------------
# Link to the admin interface for users with memberships.
# NUXT_PUBLIC_ADMIN_BASE_URL is also needed for the Live Preview of the Hero:
# its origin is the only one allowed to frame /preview/hero and the only one
# the preview accepts a Draft from. Leave it empty and the preview route
# answers 404.
NUXT_ADMIN_BASE_URL=
NUXT_PUBLIC_ADMIN_BASE_URL=

# --- Feature flags -------------------------------------------------------------
# Silent SSO on page load (Keycloak)
NUXT_PUBLIC_SILENT_SSO_ENABLED=false

# Server-side SWR cache for catalog and theme proxies (enabled by default)
# Set to "false" to disable the cache (recommended for local development).
# It also forces NUXT_THEME_REVALIDATE_SECONDS to 0.
NUXT_CACHE_ENABLED=false

# --- Theme Bundle freshness ----------------------------------------------------
# How long (seconds) a stored Theme Bundle may go unchecked before the next
# request revalidates it against the backend with a conditional GET.
# 0 revalidates on every request. Default: 5. See docs/adr/0001.
# NUXT_THEME_REVALIDATE_SECONDS=5

# How long (milliseconds) one revalidation may take before the stored copy is
# served instead. There is no retry inside a request. Default: 2000
# NUXT_THEME_REVALIDATE_TIMEOUT_MS=2000

# --- Logging -------------------------------------------------------------------
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Runtime (Docker / production) ---------------------------------------------
# PORT=3000
# NODE_ENV=production
